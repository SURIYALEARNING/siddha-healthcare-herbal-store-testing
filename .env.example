# Copy this file to .env on the VPS and fill in real values.
# .env is loaded by `docker compose` (from this folder) and is NOT committed to git.

# --- Database (MongoDB Atlas) ---
MONGODB_ATLES=mongodb+srv://USER:PASS@cluster.mongodb.net/DBNAME

# --- Auth (required) ---
ACCESS_TOKEN_SECRET=change-me-long-random-string
REFRESH_TOKEN_SECRET=change-me-long-random-string

# --- Frontend origin (used for CORS + Google OAuth redirect) ---
FRONTEND_URL=https://store.lakshmihealthcarecentrerockfort.com

# --- Email (Gmail app password) ---
EMAIL_USER=
EMAIL_PASS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Cloudinary (product media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini AI chatbot ---
GEMINI_API_KEY=

# --- Shiprocket (optional) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=primary
SHIPROCKET_PICKUP_PINCODE=600001
SHIPROCKET_DEFAULT_WEIGHT=0.5
