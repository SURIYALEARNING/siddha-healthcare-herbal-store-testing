    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright": "^1.62.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.8.1",
    "swiper": "^14.0.6",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
